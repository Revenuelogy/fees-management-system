# Any PostgreSQL 13+ database (local, Docker, RDS, Cloud SQL, Neon, Supabase, …).
# Add TLS options the way your provider documents them, e.g. ?sslmode=require
DATABASE_URL=postgres://fees:fees@127.0.0.1:5432/fees

# Optional. Connections the app keeps open (default 10).
# DATABASE_POOL_MAX=10

# Optional. How long the API keeps database reads in memory, in seconds (default 30).
# Writes made through the app clear the cache at once; this only bounds how long a change made
# elsewhere (another app instance, a manual SQL fix) can take to show up. 0 turns caching off.
# CACHE_TTL_SECONDS=30
