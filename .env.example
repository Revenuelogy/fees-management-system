# Supabase project (Project Settings -> API). For local dev run `npx supabase start`
# and copy the values it prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional, server only: lets an admin create staff logins from Settings -> Staff.
# Never expose this key to the browser.
SUPABASE_SECRET_KEY=
